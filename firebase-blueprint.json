{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Registered user profile records",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "createdAt": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "premiumStatus": { "type": "string", "enum": ["Free", "Premium"] },
        "subscriptionPlan": { "type": "string" },
        "subscriptionStartDate": { "type": "string" },
        "subscriptionExpiryDate": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "fullName", "email", "mobile", "premiumStatus"]
    },
    "purchases": {
      "title": "Purchases",
      "description": "Premium subscription purchase transactions",
      "type": "object",
      "properties": {
        "purchaseId": { "type": "string" },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "planPurchased": { "type": "string" },
        "amountPaid": { "type": "number" },
        "purchaseDate": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["purchaseId", "uid", "userName", "email", "planPurchased", "amountPaid"]
    },
    "notifications": {
      "title": "Admin Notifications",
      "description": "Real-time alerts for new registrations and premium purchases",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["new_user", "premium_purchase"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "userName": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "status": { "type": "string" },
        "plan": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["type", "userName", "email", "timestamp"]
    },
    "push_notifications": {
      "title": "Push Notifications (FCM)",
      "description": "FCM Push notifications for workout reminders, goal achievements, and community interactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["workout_reminder", "goal_achievement", "community_interaction", "general"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "icon": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["type", "title", "body", "timestamp"]
    }
  }
}
